        "id",
        "patient_id",
        "question",
        "answers",
        "concerning_answers",
        "scheduled_time",
        "recurrence",
        "enabled",
        "created_by",
        "created_at"
      ],
      "answers": "JSON array of predefined selectable answers.",
      "concerning_answers": "JSON array identifying answers that should generate alerts."
    },

    "medicines": {
      "purpose": "Store medicine schedule configuration.",
      "fields": [
        "id",
        "patient_id",
        "name",
        "dosage",
