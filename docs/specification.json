{
  "project": {
    "name": "P-kun Elder-Care Assistant Platform",
    "short_name": "P-kun Platform",
    "version": "1.0 Prototype",
    "type": "Caregiver-managed elderly care assistance platform",
    "purpose": "A web-based platform where nurses or caregivers manage each patient's daily care routine, schedules, care activities, messages and monitoring, while a Raspberry Pi-based P-kun device acts as the patient-facing interface. P-kun displays scheduled activities, collects simple patient responses, provides rehabilitation activities, and allows patients to send preset requests to caregivers.",
    "primary_goal": "Build a functional end-to-end prototype that demonstrates the complete caregiver -> platform -> P-kun -> patient -> platform -> caregiver feedback loop.",
    "scope_principle": "Prioritize a reliable working prototype over enterprise-level healthcare complexity.",
    "important_scope_limit": "Do not implement a formal clinical care-plan system, diagnosis system, electronic medical record system, hospital information system, billing system, or other unnecessary enterprise healthcare functionality."
  },

  "system_concept": {
    "description": "The healthcare platform is the primary system of record for patients and their scheduled care activities. Caregivers use the React web dashboard to manage patients, configure schedules, monitor responses and review alerts. P-kun is a connected physical patient-facing endpoint that retrieves relevant scheduled events, presents them to the elderly user, collects simple responses and synchronizes results with the platform.",
    "source_of_truth": "Supabase PostgreSQL database",
    "calendar_role": "The calendar is the primary user interface for viewing and managing scheduled care events. The database remains the actual source of truth.",
    "p_kun_role": "P-kun is a connected patient-facing interface and should not contain the primary patient management logic.",
    "platform_without_p_kun": "The web platform should remain usable for managing patients, schedules, history and alerts even when a P-kun device is offline.",
    "closed_loop": [
      "Caregiver creates or modifies a care event",
      "Event is stored in Supabase",
      "Relevant P-kun receives the updated event",
      "P-kun displays the event to the patient",
      "Patient interacts with P-kun",
      "P-kun records the response",
      "Response is synchronized with Supabase",
      "Platform updates the event and patient history",
      "Caretaker can see the result",
      "Important responses can generate alerts"
    ]
  },

  "technology_stack": {
    "frontend": {
      "framework": "React",
      "language": "TypeScript preferred",
      "routing": "React Router",
      "state_management": "Use React state and lightweight context where sufficient. Do not introduce a large state-management framework unless genuinely necessary.",
      "ui": "Use a clean modern responsive dashboard UI suitable for nurses and caregivers.",
      "calendar": "Use a mature React calendar component/library rather than implementing a calendar from scratch.",
      "charts": "Use simple charts only where they improve understanding of patient activity or history."
    },

    "backend": {
      "platform": "Supabase",
      "database": "Supabase PostgreSQL",
      "authentication": "Supabase Auth",
      "realtime": "Supabase Realtime",
      "storage": "Supabase Storage for patient profile photos if required",
      "server_logic": "Supabase Edge Functions only where server-side processing is actually required"
    },

    "p_kun": {
      "hardware": "Raspberry Pi 4 GB",
      "operating_system": "Ubuntu Server",
      "application_language": "Python",
      "ui_framework": "Kivy",
      "local_database": "SQLite",
      "communication": "Supabase",
      "robot_middleware": "ROS 2 through rclpy"
    }
  },

  "architecture": {
    "high_level": [
      "React Caregiver Dashboard",
      "Supabase Authentication",
      "Supabase PostgreSQL",
      "Supabase Realtime",
      "Raspberry Pi P-kun Application",
      "P-kun Local SQLite Cache",
      "ROS 2 robotics interface"
    ],

    "communication": {
      "dashboard_to_backend": "React communicates with Supabase.",
      "p_kun_to_backend": "P-kun communicates with Supabase.",
      "dashboard_to_p_kun": "Dashboard does not communicate directly with the Raspberry Pi.",
      "p_kun_to_dashboard": "P-kun does not communicate directly with the dashboard.",
      "network": "Both clients communicate through Supabase over the available network connection.",
      "local_network": "The Raspberry Pi and caregiver computer may be connected to the same Wi-Fi during a demonstration, but the application must not depend on direct local IP communication."
    },

    "realtime": {
      "purpose": [
        "Deliver newly created or modified care events to P-kun",
        "Deliver caregiver messages to P-kun",
        "Update caregiver dashboard when patient responses arrive",
        "Display patient requests and alerts in near real time",
        "Update device online status"
      ],
      "restriction": "Supabase Realtime is an event propagation mechanism and must not be treated as the scheduling engine."
    },

    "scheduling": {
      "source": "Supabase-stored care events",
      "prototype_model": "Use a simple dated care-event model. Do not implement a complex care-event-template and occurrence architecture for this prototype.",
      "recurrence": "Store recurrence information with the event and generate/manage dated occurrences only as necessary for the prototype.",
      "missed_events": "Event status should be determined by backend/application logic rather than relying exclusively on the Raspberry Pi."
    }
  },

  "user_roles": {
    "caretaker": {
      "description": "Nurse, caregiver or authorized staff member responsible for managing and monitoring elderly patients.",
      "permissions": [
        "Log in",
        "Create patients",
        "Edit patients",
        "View patients",
        "Add caretaker-only care notes",
        "Create care events",
        "Edit care events",
        "Delete or disable care events",
        "Configure daily check-ins",
        "Configure medicine schedules",
        "Configure meal schedules",
        "Configure task reminders",
        "Assign rehabilitation games",
        "Send messages to patients",
        "View patient responses",
        "View patient history",
        "View alerts",
        "Review alerts",
        "View device status",
        "Assign P-kun devices to patients"
      ]
    },

    "patient": {
      "description": "The elderly person interacting with the P-kun device.",
      "interaction": [
        "Answer daily check-in questions",
        "Confirm medicine intake",
        "Confirm meal completion",
        "Interact with scheduled activities",
        "Play assigned rehabilitation games",
        "Receive caregiver messages",
        "Send preset messages to the caretaker at any time"
      ],
      "restriction": "Patients do not log into or manage the caregiver web dashboard in this prototype."
    }
  },

  "database": {
    "design_principle": "Keep the database understandable and practical for a prototype while maintaining clear relationships and organization-level security.",

    "organizations": {
      "purpose": "Represent a healthcare organization or facility.",
      "fields": [
        "id",
        "name",
        "created_at"
      ]
    },

    "profiles": {
      "purpose": "Authenticated caregiver and staff profiles.",
      "fields": [
        "id",
        "organization_id",
        "full_name",
        "role",
        "created_at"
      ],
      "roles": [
        "admin",
        "caretaker"
      ]
    },

    "patients": {
      "purpose": "Store basic information about elderly users.",
      "fields": [
        "id",
        "organization_id",
        "name",
        "date_of_birth",
        "age",
        "profile_photo",
        "assigned_caretaker_id",
        "emergency_contact",
        "status",
        "special_requirements",
        "dietary_requirements",
        "food_restrictions",
        "allergies",
        "mobility_notes",
        "communication_preferences",
        "behavioral_notes",
        "other_notes",
        "created_at",
        "updated_at"
      ],
      "status_values": [
        "ACTIVE",
        "INACTIVE"
      ],
      "privacy_rule": "All care notes are caretaker-only information and must never be sent to or displayed by P-kun."
    },

    "care_events": {
      "purpose": "Represent scheduled patient care activities.",
      "fields": [
        "id",
        "patient_id",
        "event_type",
        "title",
        "description",
        "scheduled_date",
        "scheduled_time",
        "recurrence",
        "status",
        "response_required",
        "response_data",
        "created_by",
        "created_at",
        "updated_at",
        "completed_at"
      ],
      "event_types": [
        "DAILY_CHECK_IN",
        "MEDICINE",
        "TASK",
        "MEAL",
        "REHABILITATION_GAME"
      ],
      "status_values": [
        "SCHEDULED",
        "PENDING",
        "COMPLETED",
        "MISSED",
        "ALERT",
        "SKIPPED"
      ],
      "response_data": "Use JSONB for event-specific information such as selected check-in answer, medicine response or game result."
    },

    "check_in_questions": {
      "purpose": "Store configurable patient check-in questions.",
