    "pairing_codes": {
      "purpose": "Temporarily authorize a P-kun device to register with an organization.",
      "fields": [
        "id",
        "organization_id",
        "code",
        "expires_at",
        "used",
        "created_at"
      ],
      "security": "Pairing codes must expire and must not function as permanent device credentials."
    },

    "interaction_logs": {
      "purpose": "Record important system and patient interactions for history and debugging.",
      "fields": [
        "id",
        "patient_id",
        "device_id",
        "event_id",
        "action",
        "data",
        "created_at"
      ]
    }
