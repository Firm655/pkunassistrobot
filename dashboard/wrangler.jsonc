{
  // Cloudflare Workers static-assets config for the caregiver dashboard.
  // Build first (npm run build), then `npx wrangler deploy` uploads dist/.
  "name": "pkun-dashboard",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths like /patients/123 serve index.html
    "not_found_handling": "single-page-application"
  }
}
